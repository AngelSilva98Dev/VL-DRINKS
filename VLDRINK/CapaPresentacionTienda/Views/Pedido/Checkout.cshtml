@* 1. Definimos el Modelo: Le decimos a la vista que espera un objeto 'Carrito' *@
@model CapaEntidad.Carrito
@{
    ViewBag.Title = "Finalizar Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";


    CapaEntidad.Cliente cliente = (CapaEntidad.Cliente)ViewBag.Cliente;
    if (cliente == null)
    {

        cliente = new CapaEntidad.Cliente();
    }
}

<div class="container py-5">
    <h2>@ViewBag.Title</h2>
    <p>Por favor, confirma tus datos para finalizar el pedido.</p>

    @using (Html.BeginForm("Checkout", "Pedido", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-7">
                <h4>Datos de Contacto y Envío</h4>
                <hr />

                <div class="mb-3">
                    <label for="Contacto" class="form-label">Nombre Completo</label>
                    <input type="text" class="form-control" id="Contacto" name="Contacto"
                           value="@(cliente.Nombres + " " + cliente.Apellidos)" required>
                </div>

                <div class="mb-3">
                    <label for="Telefono" class="form-label">Teléfono (WhatsApp)</label>
                    <input type="tel" class="form-control" id="Telefono" name="Telefono"
                           placeholder="Ej: 3511234567" value="@cliente.Telefono" required>
                </div>

                <div class="mb-3">
                    <label for="Direccion" class="form-label">Dirección de Envío</label>
                    <input type="text" class="form-control" id="Direccion" name="Direccion"
                           value="@cliente.Direccion" required>
                </div>

                <h4 class="mt-4">Método de Pago</h4>
                <hr />
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="MetodoPago" id="pagoEfectivo" value="Efectivo" checked>
                    <label class="form-check-label" for="pagoEfectivo">
                        Efectivo (Pagas al recibir el pedido)
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="MetodoPago" id="pagoTransferencia" value="Transferencia">
                    <label class="form-check-label" for="pagoTransferencia">
                        Transferencia Bancaria (Alias/CBU)
                    </label>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        @ViewBag.Error
                    </div>
                }

            </div>

            <div class="col-md-5">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">Resumen del Pedido</h5>
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                                    @item.objProducto.Nombre (x @item.Cantidad)
                                    <span>$@item.Subtotal</span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                                <strong>Total</strong>
                                <strong>$@Model.CalcularTotal()</strong>
                            </li>
                        </ul>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-success btn-lg">Realizar Pedido</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
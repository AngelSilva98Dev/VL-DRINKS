@{
    ViewBag.Title = "Marcas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Resumen</a></li>
    <li class="breadcrumb-item active">Marcas</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-bookmark me-1"></i> Lista de Marcas
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-12">
                <button type="button" class="btn btn-success" id="btnNuevaMarca">Crear Nueva</button>
            </div>
        </div>

        <hr />

        <table id="tablaMarca" class="display cell-border" style="width: 100%">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

    </div>
</div>

<div class="modal fade" id="FormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo">Nueva Marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formMarca">
                    <input type="hidden" id="txtIdMarca" value="0">

                    <div class="mb-3">
                        <label for="txtDescripcion" class="form-label">Descripción</label>
                        <input type="text" class="form-control" id="txtDescripcion" required>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="chkActivo" checked>
                        <label class="form-check-label" for="chkActivo">Activo</label>
                    </div>

                    <div id="modalErrorMsg" class="alert alert-danger d-none" role="alert"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script>
        $(document).ready(function () {

            var modal;
            var modalElement = document.getElementById('FormModal');
            if(modalElement) {
                modal = new bootstrap.Modal(modalElement);
            }

            // 1. Configuración de DataTables
            var tabla = $('#tablaMarca').DataTable({
                "ajax": {
                    "url": "@Url.Action("ListarMarcas", "Mantenedor")",
                    "type": "GET",
                    "dataType": "json"
                },
                "columns": [
                    // C# (MVC 5) envía IdMarca con 'I' mayúscula
                    { "data": "IdMarca", "visible": false },
                    { "data": "Descripcion" },
                    {
                        "data": "Activo",
                        "render": function (data) {
                            return data ? '<span class="badge bg-success">Activo</span>' : '<span class="badge bg-danger">Inactivo</span>';
                        }
                    },
                    {
                        "data": null,
                        "render": function (data, type, row) {
                            var btnEditar = '<button type="button" class="btn btn-primary btn-sm btn-editar" title="Editar"><i class="fas fa-pencil-alt"></i></button>';
                            var btnEliminar = '<button type="button" class="btn btn-danger btn-sm btn-eliminar" title="Eliminar"><i class="fas fa-trash"></i></button>';
                            return btnEditar + " " + btnEliminar;
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "90px"
                    }
                ]
            });

            // 2. Evento: "Crear Nuevo"
            $("#btnNuevaMarca").on("click", function () {
                $("#formMarca")[0].reset();
                $("#txtIdMarca").val("0");
                $("#chkActivo").prop("checked", true);
                $("#modalErrorMsg").addClass("d-none");
                $("#modalTitulo").text("Nueva Marca");
                if(modal) modal.show();
            });

            // 3. Evento: Clic en "Editar" (lápiz)
            $('#tablaMarca tbody').on('click', '.btn-editar', function () {
                var fila = $(this).closest('tr');
                var data = tabla.row(fila).data();

                if (data) {
                    $("#txtIdMarca").val(data.IdMarca);
                    $("#txtDescripcion").val(data.Descripcion);
                    $("#chkActivo").prop("checked", data.Activo);

                    $("#modalErrorMsg").addClass("d-none");
                    $("#modalTitulo").text("Modificar Marca");
                    if(modal) modal.show();
                }
            });

            // 4. Evento: Clic en "Guardar"
            $("#btnGuardar").on("click", function () {
                var marca = {
                    IdMarca: $("#txtIdMarca").val(),
                    Descripcion: $("#txtDescripcion").val(),
                    Activo: $("#chkActivo").is(":checked")
                };

                var esNuevo = (marca.IdMarca == "0");
                var url = esNuevo ? '@Url.Action("GuardarMarca", "Mantenedor")' : '@Url.Action("ModificarMarca", "Mantenedor")';

                $.ajax({
                    url: url,
                    type: "POST",
                    data: marca,
                    dataType: "json",
                    success: function (response) {
                        if (response.operacionExitosa) {
                            modal.hide();
                            tabla.ajax.reload();
                            var titulo = esNuevo ? '¡Marca Creada!' : '¡Marca Modificada!';
                            Swal.fire(titulo, response.mensaje, 'success');
                        } else {
                            $("#modalErrorMsg").text(response.mensaje);
                            $("#modalErrorMsg").removeClass("d-none");
                        }
                    }
                });
            });

            // 5. Evento: Clic en "Eliminar" (basura)
            $('#tablaMarca tbody').on('click', '.btn-eliminar', function () {
                var fila = $(this).closest('tr');
                var data = tabla.row(fila).data();

                Swal.fire({
                    title: '¿Estás seguro?',
                    text: `¿Deseas eliminar la marca "${data.Descripcion}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("EliminarMarca", "Mantenedor")',
                            type: "POST",
                            data: { idMarca: data.IdMarca },
                            dataType: "json",
                            success: function (response) {
                                if (response.operacionExitosa) {
                                    tabla.ajax.reload();
                                    Swal.fire('¡Eliminada!', 'La marca ha sido eliminada.', 'success');
                                } else {
                                    Swal.fire('Error', response.mensaje, 'error');
                                }
                            }
                        });
                    }
                });
            });

        });
    </script>
}
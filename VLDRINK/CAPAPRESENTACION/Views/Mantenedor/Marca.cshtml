
@{
    ViewBag.Title = "Marca";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="index.html">Mantenimiento</a></li>
    <li class="breadcrumb-item active">Marcas</li>
</ol>

<div class="card">
    <div class="card-header">
        <i class="fas fa-users me-1">

        </i>Lista de Categorias
    </div>
    <div class=" card-body">
        <div class="row">
            <div class="col-sm-12">
                <button type="button" class="btn btn-success" onclick="abrirModal(null)">Crear Nuevo</button>
            </div>
        </div>

        <hr />
        <table id="tabla" class="display cell-border" style="width: 100%">
            <thead>
                <tr>
                    <th>Descripcion</th>
                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

    </div>
</div>
<!--Modal-->
<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="exampleModalLabel">Marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" value="0" type="hidden" />
                <div class="row g-1">


                    <div class="col-sm-10">
                        <label for="txtdescripcion" class="form-label">Descripcion</label>
                        <input type="text" class="form-control" id="txtdescripcion" autocomplete="off">
                    </div>

                    <div class="col-sm-6">
                        <label for="cboactivo" class="form-label">Activo</label>
                        <select id="cboactivo" class="form-select">
                            <option value="1">Si</option>
                            <option value="0">No</option>
                        </select>
                    </div>

                </div>
                <!--Mensaje de alerta-->
                <div class="row mt-3">
                    <div class="col-12">
                        <div id="mensajeAlerta" class="alert alert-danger" role="alert">
                            <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>
                            A simple danger alert—check it out!
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>

       let tablaDatos;
        var filaSeleccionada

        tablaDatos = $("#tabla").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                url: '@Url.Action("ListarMarca","Mantenedor")',
                type: "GET",
                dataType: "json"
            },
            "columns": [
                { "data": "Descripcion" },
                {
                    "data": "Activo", "render": function (valor) {
                        if (valor) {
                            return '<span class= "badge bg-success">Si</span>'
                        } else {
                            return '<span class="badge bg-danger">No</span'
                        }
                    }
                },
                {
                    "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar"><i class= "fas fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminar"><i class= "fas fa-trash"></i></button>',
                    "orderable": false,
                    "searchable": false,
                        "width":"90px"

                }

            ],
            "language": {
                "url":"//cdn.datatables.net/plug-ins/2.3.4/i18n/es-ES.json"
            }
        });

        function abrirModal(json) {

            $("#txtid").val(0);
            $("#txtdescripcion").val("");
            $("#cboactivo").val(1);

            $("#mensajeAlerta").hide();

            if (json != null) {

                $("#txtid").val(json.IdMarca);
                $("#txtdescripcion").val(json.Descripcion);
                $("#cboactivo").val(json.Activo == true ? 1 : 0);

            }

            $("#FormModal").modal("show")
        }

        $("#tabla tbody").on("click", '.btn-editar', function () {

            filaSeleccionada = $(this).closest("tr");

            var data = tablaDatos.row(filaSeleccionada).data();

            abrirModal(data)
        })


        $("#tabla tbody").on("click", '.btn-eliminar', function () {

            var marcaSeleccionada = $(this).closest("tr");

            var data = tablaDatos.row(marcaSeleccionada).data();

            swal({
                title: "Estas seguro?",
                text: "Esto eliminara la marca permanentemente",
                type: "warning",
                showCancelButton: true,
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Si",
                cancelButtonText: "No",
                closeOnConfirm: false
            },
                function () {
                    jQuery.ajax({
                        url: '@Url.Action("EliminarMarca","Mantenedor")',
                        type: "POST",
                        data: JSON.stringify({ id: data.IdMarca }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {

                            if (data.resultado) {
                                tablaDatos.row(marcaSeleccionada).remove().draw();
                                swal("Eliminado!", "La marca ha sido removida", "success");

                            } else {
                                swal("No se pudo eliminar", data.mensaje, "error");
                            }

                        },
                        error: function (error) {
                            console.log(error);
                        }
                    });

                });

            console.log(data);
        })

        function Guardar() {

            var Marca = {

                IdMarca: $("#txtid").val(),
                Descripcion: $("#txtdescripcion").val(),
                Activo: $("#cboactivo").val() == 1 ? true : false
            }

            jQuery.ajax({
                url: '@Url.Action("GuardarMarca","Mantenedor")',
                type: "POST",
                data: JSON.stringify({ objMarca: Marca }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {


                    $(".modal-body").LoadingOverlay("hide");

                    if (Marca.IdMarca == 0) {

                        if (data.resultado != 0) {

                            Marca.IdMarca = data.resultado;
                            tablaDatos.row.add(Marca).draw(false);
                            $("#FormModal").modal("hide")

                        } else {

                            $("#mensajeAlerta").html('<i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>'+data.mensaje);
                            $("#mensajeAlerta").show();
                            setTimeout(() => {
                                $("#mensajeAlerta").fadeOut();
                            }, 3500);
                        }

                    } else {

                        if (data.resultado) {

                            tablaDatos.row(filaSeleccionada).data(Marca).draw(false);
                            filaSeleccionada = null;
                            $("#FormModal").modal("hide")

                        } else {

                            $("#mensajeAlerta").html('<i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>' + data.mensaje);
                            $("#mensajeAlerta").show();
                            setTimeout(() => {
                                $("#mensajeAlerta").fadeOut();
                            }, 3500);
                        }


                    }
                },
                error: function (error) {

                    $(".modal-body").LoadingOverlay("hide");
                    $("#mensajeAlerta").html('<i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>' + "Error ajax");
                    $("#mensajeAlerta").show();
                },
                beforeSend: function () {
                    $(".modal-body").LoadingOverlay("show", {
                        imageResizeFactor: 2,
                        text: "Cargando...",
                        size: 14
                    })
                }
            });

        }

    </script>
}

